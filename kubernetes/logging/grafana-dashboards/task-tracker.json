      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "100 * sum(increase(tasks_created_total{namespace=\"default\"}[$__range])) / sum(increase(http_requests_total{namespace=\"default\",method=\"POST\",handler=\"/api/tasks\"}[$__range]))",
          "legendFormat": "",
          "instant": false,
          "range": true
