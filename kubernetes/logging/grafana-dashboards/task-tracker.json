        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 *\nsum(increase(http_request_duration_seconds_bucket{le=\"0.5\"}[$__range]))\n/\nsum(increase(http_request_duration_seconds_count[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
