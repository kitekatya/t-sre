          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Создание задач: SLI успеха",
      "description": "Созданные задачи / все попытки POST /api/tasks",
      "type": "timeseries",
